# Copiar a `.env` y completar. El `.env` real NUNCA se commitea (ver .gitignore).

# --- Base de datos -----------------------------------------------------------
# Desarrollo local con el Postgres de docker-compose.yml (puerto 5433 en el host).
DATABASE_URL=postgresql://psicoia:psicoia_local@localhost:5433/psicoia

# Si más adelante pasás a una base gestionada, pegá el connection string tal cual
# te lo den. config.py normaliza el driver a psycopg 3, así que se acepta
# cualquiera de estas formas:
#   postgresql://user:pass@host/db?sslmode=require
#   postgres://user:pass@host/db?sslmode=require
#   postgresql+psycopg://user:pass@host/db?sslmode=require

# Loguea todo el SQL emitido. Dejar en false: los queries incluyen notas clínicas.
DB_ECHO=false

# --- IA ----------------------------------------------------------------------
# Opcional. Si queda vacío, el sistema usa el proveedor `mock` (sin red) y la app
# arranca igual. Obtener en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# auto | mock | gemini   ("auto" = gemini si hay API key, mock si no)
IA_PROVIDER=auto

# --- App ---------------------------------------------------------------------
ENVIRONMENT=local
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]
