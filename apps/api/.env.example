# Copiar a `.env` y completar. El `.env` real NUNCA se commitea (ver .gitignore).

# --- Base de datos -----------------------------------------------------------
# Credenciales del contenedor de docker-compose.yml. NO son un secreto: el
# contenedor escucha únicamente en 127.0.0.1 y la base es descartable. Por eso
# están en texto plano acá y en el compose.
#
# En cualquier entorno que no sea tu máquina, esto va con una contraseña
# generada y NUNCA se escribe en el repositorio.
#
# 127.0.0.1 y NO localhost. En Windows `localhost` resuelve primero a ::1
# (IPv6), pero el compose publica el puerto solo en 127.0.0.1 (IPv4). El intento
# por IPv6 no tiene quien lo atienda y el cliente espera antes de reintentar por
# IPv4: la app arranca, pero cuelga en la primera consulta de forma intermitente.
DATABASE_URL=postgresql://psicoia:psicoia_local@127.0.0.1:5433/psicoia

# Si más adelante pasás a una base gestionada, pegá el connection string tal cual
# te lo den. config.py normaliza el driver a psycopg 3, así que se acepta
# cualquiera de estas formas:
#   postgresql://user:pass@host/db?sslmode=require
#   postgres://user:pass@host/db?sslmode=require
#   postgresql+psycopg://user:pass@host/db?sslmode=require

# Loguea todo el SQL emitido. Dejar en false: los queries incluyen notas clínicas.
DB_ECHO=false

# --- IA ----------------------------------------------------------------------
# Opcional. Si queda vacío, el sistema usa el proveedor `mock` (sin red) y la app
# arranca igual. Obtener en https://aistudio.google.com/apikey
#
# ATENCIÓN: la key va SOLO en tu `.env`, que está en .gitignore. Nunca acá, nunca
# en el código, nunca en un comentario. Si alguna vez se filtra una, revocala en
# la consola del proveedor: rotarla es lo único que sirve, borrar el commit no.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# auto | mock | gemini   ("auto" = gemini si hay API key, mock si no)
IA_PROVIDER=auto

# --- App ---------------------------------------------------------------------
ENVIRONMENT=local
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]
