# Copiar a `.env.local`. Ese archivo NO se commitea.
#
# ATENCIÓN: todo lo que empiece con NEXT_PUBLIC_ se embebe en el bundle que baja
# el navegador. NUNCA pongas acá una API key ni ningún secreto: sería público.
# Las credenciales de IA viven sólo en el backend (apps/api/.env).

NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
