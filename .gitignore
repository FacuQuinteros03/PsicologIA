# === Secretos: datos clínicos, nunca al repo ===
.env
.env.*
!.env.example
!.env.local.example

# === Python ===
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

# === Node / Next.js ===
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts
.vercel/

# === Editores / SO ===
.vscode/*
# Estos tres sí se versionan: codifican cómo se levanta el proyecto (incluido el
# flag --loop, que en Windows es obligatorio) y qué intérprete usar. Sin ellos,
# cada persona que clone tiene que redescubrirlo.
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

*.gdoc
*.gsheet
