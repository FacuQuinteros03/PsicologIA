{
  // Ctrl+Shift+B levanta todo (base + API + web).
  // Ctrl+Shift+P -> "Tasks: Run Task" para las demás.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Base de datos (Docker)",
      "type": "shell",
      // `--wait` no es cosmético: sin él `up -d` vuelve apenas el contenedor
      // arranca, pero Postgres todavía está inicializando y no acepta
      // conexiones. La API arrancaría contra una base que aún no escucha.
      // Con `--wait`, compose bloquea hasta que el healthcheck da healthy.
      "command": "docker compose up -d --wait",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "2. API (FastAPI)",
      "type": "shell",
      // El flag --loop NO es opcional en Windows: psycopg async no funciona
      // sobre ProactorEventLoop, que es el que elige uvicorn por defecto.
      "command": "${workspaceFolder}/apps/api/.venv/Scripts/uvicorn.exe",
      "args": [
        "app.main:app",
        "--reload",
        "--port",
        "8000",
        "--loop",
        "asyncio:SelectorEventLoop"
      ],
      "options": { "cwd": "${workspaceFolder}/apps/api" },
      "isBackground": true,
      // Un problemMatcher de background le dice a VS Code cuándo el servidor
      // terminó de arrancar. Sin esto la tarea queda girando "en ejecución"
      // para siempre y no se puede encadenar con otras.
      "problemMatcher": {
        "owner": "uvicorn",
        "pattern": { "regexp": "^(?:)$", "file": 1, "location": 2, "message": 3 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Started reloader.*",
          "endsPattern": ".*Application startup complete.*"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "dev" }
    },
    {
      "label": "3. Web (Next.js)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/apps/web" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "next",
        "pattern": { "regexp": "^(?:)$", "file": 1, "location": 2, "message": 3 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*(Next\\.js|Starting).*",
          "endsPattern": ".*(Ready in|compiled successfully).*"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "dev" }
    },
    {
      // Nivel intermedio a propósito. `dependsOrder: sequence` espera a que cada
      // tarea TERMINE, y un servidor no termina nunca: encadenar los tres en
      // secuencia dejaba la web sin arrancar. Acá la base corre y termina, y
      // recién después los dos servidores salen juntos en paralelo.
      "label": "Servidores (API + Web)",
      "dependsOn": ["2. API (FastAPI)", "3. Web (Next.js)"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "▶ Levantar todo",
      "dependsOn": ["1. Base de datos (Docker)", "Servidores (API + Web)"],
      "dependsOrder": "sequence",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "■ Detener todo",
      "type": "shell",
      // Mata por línea de comandos, NO por dueño del puerto.
      //
      // `uvicorn --reload` corre en dos procesos: el reloader vigila los
      // archivos y un hijo es el que sirve. El socket de escucha lo abre el
      // padre y lo hereda el hijo, así que netstat se lo atribuye al padre.
      // Matar sólo a ese dueño deja al hijo vivo, sirviendo, con la config
      // vieja en memoria y quedándose con el puerto: netstat pasa a mostrar un
      // listener de un PID que ya no existe. Windows permite varios sockets en
      // el mismo puerto y reparte las conexiones entre todos, así que con
      // huérfanos dando vueltas una request responde en 5 ms y la siguiente
      // se cuelga, según a cuál le toque.
      //
      // El filtro por 'PsicoIA' evita tocar cualquier otro node o python.
      "command": "docker compose stop; Get-CimInstance Win32_Process | Where-Object { $_.CommandLine -match 'PsicoIA' -and $_.CommandLine -match 'uvicorn|next' } | ForEach-Object { & taskkill /F /T /PID $_.ProcessId 2>$null }; Get-NetTCPConnection -LocalPort 3000,8000 -State Listen -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess -Unique | ForEach-Object { & taskkill /F /T /PID $_ 2>$null }",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "Verificar backend (36 checks)",
      "type": "shell",
      "command": "${workspaceFolder}/apps/api/.venv/Scripts/python.exe",
      "args": ["scripts/verificar_backend.py"],
      "options": { "cwd": "${workspaceFolder}/apps/api" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Escanear secretos",
      "type": "shell",
      "command": "python",
      "args": ["scripts/escanear_secretos.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Tests del backend",
      "type": "shell",
      "command": "${workspaceFolder}/apps/api/.venv/Scripts/python.exe",
      "args": ["-m", "pytest", "-q"],
      "options": { "cwd": "${workspaceFolder}/apps/api" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
